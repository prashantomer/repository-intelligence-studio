<% content_for :title, "Provider Call Logs" %>

<div class="page provider-logs-page">
  <section class="card provider-log-filter-card">
    <%= form_with url: provider_call_logs_path, method: :get, local: true do |form| %>
      <div class="form-grid four-up log-filter-grid">
        <div class="field">
          <%= form.label :repository_id, "Repository" %>
          <%= form.select :repository_id,
                          options_for_select([["All repositories", ""]] + @repositories.map { |repository| [repository.name, repository.id] }, params[:repository_id]),
                          {},
                          onchange: "this.form.requestSubmit()" %>
        </div>

        <div class="field">
          <%= form.label :provider, "Provider" %>
          <%= form.select :provider,
                          options_for_select([["All providers", ""]] + Repository::ASSISTANT_PROVIDERS.values.union(Repository::EMBEDDING_PROVIDERS.values).map { |provider| [provider.humanize, provider] }, params[:provider]),
                          {},
                          onchange: "this.form.requestSubmit()" %>
        </div>

        <div class="field">
          <%= form.label :operation_type, "Operation" %>
          <%= form.select :operation_type,
                          options_for_select([["All operations", ""]] + ProviderCallLog.operation_types.keys.map { |operation| [operation.humanize, operation] }, params[:operation_type]),
                          {},
                          onchange: "this.form.requestSubmit()" %>
        </div>

        <div class="field">
          <%= form.label :status, "Status" %>
          <%= form.select :status,
                          options_for_select([["Any status", ""]] + ProviderCallLog.statuses.keys.map { |status| [status.humanize, status] }, params[:status]),
                          {},
                          onchange: "this.form.requestSubmit()" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="card provider-log-history-card">
    <div class="section-title">
      <div>
        <h2>Call History</h2>
        <p class="page-copy">Recent assistant and embedding executions with usage and cost metadata.</p>
      </div>
    </div>

    <% if @provider_call_logs.any? %>
      <div class="table-scroll audit-log-table-shell">
        <table class="data-table provider-call-log-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Repository</th>
              <th>Operation</th>
              <th>Provider</th>
              <th>Status</th>
              <th>Usage</th>
              <th>Latency</th>
              <th>Cost</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% @provider_call_logs.each do |log| %>
              <tr>
                <td><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
                <td><%= log.repository.name %></td>
                <td>
                  <strong><%= log.operation_type.humanize %></strong>
                  <div class="repository-row-copy"><%= log.endpoint.presence || "internal" %></div>
                </td>
                <td>
                  <strong><%= log.provider %></strong>
                  <div class="repository-row-copy"><%= log.model %></div>
                </td>
                <td>
                  <span class="status-pill status-<%= log.status %>"><%= log.status.humanize %></span>
                  <% if log.error_message.present? %>
                    <div class="repository-row-copy"><%= log.error_message %></div>
                  <% end %>
                </td>
                <td>
                  <div class="log-meta-stack">
                    <span>Prompt: <%= log.prompt_tokens %></span>
                    <span>Completion: <%= log.completion_tokens %></span>
                    <span>Total: <%= log.total_tokens %></span>
                  </div>
                </td>
                <td><%= "#{log.latency_ms} ms" %></td>
                <td><%= log.estimated_cost_usd.nil? ? "n/a" : "$#{format("%.6f", log.estimated_cost_usd)}" %></td>
                <td>
                  <details class="log-details">
                    <summary>Inspect</summary>
                    <div class="log-json-preview">
                      <strong>Request</strong>
                      <pre><%= JSON.pretty_generate(log.request_metadata) %></pre>
                      <strong>Response</strong>
                      <pre><%= JSON.pretty_generate(log.response_metadata) %></pre>
                    </div>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <section class="empty-state workspace-empty">
        <h2>No provider call logs yet</h2>
        <p>Assistant and embedding calls will appear here once remote providers are used.</p>
      </section>
    <% end %>
  </section>
</div>
