<div class="assistant-chat-body" id="assistant-chat-body">
  <% if messages.empty? %>
    <section class="empty-state assistant-empty-state" id="assistant-empty-state">
      <h2>Start the first repository conversation</h2>
      <p>Ask about architecture, execution flow, dependencies, indexing, or likely impact of a change.</p>
    </section>
  <% end %>

  <div class="message-list assistant-message-list" id="assistant-message-list">
    <%= render partial: "repositories/assistant/message",
               collection: messages,
               as: :message,
               locals: { repository: repository } %>
  </div>
</div>
