<div class="assistant-composer" id="assistant-composer">
  <%= form_with url: ask_repository_path(repository), method: :post, class: "assistant-composer-form", data: { assistant_form: true } do |form| %>
    <%= hidden_field_tag :conversation_id, conversation&.id %>

    <div class="assistant-composer-box">
      <div class="field assistant-composer-field">
        <%= form.text_area :question,
                           rows: 3,
                           placeholder: "Ask about flow, architecture, jobs, routes, embeddings, or impact...",
                           class: "assistant-composer-input",
                           data: { assistant_form_target: "input" } %>
        <span class="field-hint">Grounded to the latest ingested snapshot and recent thread context.</span>
      </div>

      <div class="assistant-composer-actions">
        <span class="assistant-composer-hint">Follow-up questions reuse recent thread context.</span>
        <%= form.submit "Send", class: "button button-primary assistant-send-button", data: { assistant_form_target: "submit" } %>
      </div>
    </div>
  <% end %>
</div>
