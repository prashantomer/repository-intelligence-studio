<%= turbo_stream.replace "assistant-chat-body" do %>
  <%= render "repositories/assistant/chat_body", repository: @repository, messages: @messages %>
<% end %>

<%= turbo_stream.replace "assistant-composer" do %>
  <%= render "repositories/assistant/composer", repository: @repository, conversation: @conversation %>
<% end %>

<%= turbo_stream.replace "assistant-thread-status" do %>
  <div class="assistant-chat-meta" id="assistant-thread-status">
    <span class="status-pill">Active thread</span>
  </div>
<% end %>

<%= turbo_stream.replace "assistant-session-stats" do %>
  <%= render "repositories/assistant/session_stats", repository: @repository, messages: @messages %>
<% end %>
