<% content_for :title, "Search #{@repository.name}" %>

<div class="page">
  <section class="hero-card">
    <div class="page-header">
      <div>
        <p class="eyebrow">Semantic Search</p>
        <h1><%= @repository.name %></h1>
        <p class="page-copy">Search generated code chunks for this repository only. Results are ranked by embedding similarity.</p>
        <div class="meta-inline">
          <span>Provider: <%= @repository.embedding_provider %></span>
          <span>Model: <%= @repository.embedding_model %></span>
          <span>Results: <%= @results.size %></span>
        </div>
      </div>

      <div class="hero-actions">
        <%= link_to "Back to Repository", repository_path(@repository), class: "button button-secondary" %>
        <%= link_to "AI Settings", edit_settings_path, class: "button button-secondary" %>
        <%= link_to "Assistant", assistant_repository_path(@repository), class: "button button-secondary" %>
      </div>
    </div>
  </section>

  <turbo-frame id="search-workspace">
    <div class="two-column-grid">
      <section class="card">
        <div class="section-title">
          <div>
            <h2>Search Repository Chunks</h2>
            <p class="page-copy">Use implementation-level questions, feature names, classes, modules, or route concepts.</p>
          </div>
        </div>

        <%= form_with url: search_repository_path(@repository), method: :get, data: { turbo_frame: "search-workspace" } do |form| %>
          <div class="form-grid">
            <div class="field">
              <%= form.label :q, "Search query" %>
              <%= form.text_field :q, value: @query, placeholder: "How is task execution handled?" %>
              <span class="field-hint">Changing embedding provider or model requires a re-sync before results are consistent.</span>
            </div>
          </div>

          <div class="button-row">
            <%= form.submit "Search", class: "button button-primary" %>
          </div>
        <% end %>
      </section>

      <aside class="card card-muted">
        <div class="section-title">
          <div>
            <h2>Search Scope</h2>
            <p class="page-copy">What this page searches.</p>
          </div>
        </div>

        <div class="timeline-list">
          <article class="timeline-item">
            <span class="timeline-title">Repository-scoped only</span>
            <span class="timeline-meta">No cross-repository mixing in retrieval.</span>
          </article>
          <article class="timeline-item">
            <span class="timeline-title">Chunk-based retrieval</span>
            <span class="timeline-meta">Matches are returned from stored code/document chunks.</span>
          </article>
          <article class="timeline-item">
            <span class="timeline-title">Embedding-backed ranking</span>
            <span class="timeline-meta">Similarity depends on the current user's centralized embedding provider.</span>
          </article>
        </div>
      </aside>
    </div>

    <% if @query.present? %>
      <section class="card">
        <div class="section-title">
          <div>
            <h2>Results</h2>
            <p class="page-copy">Top repository chunk matches for <strong><%= @query %></strong>.</p>
          </div>
        </div>

        <% if @results.any? %>
          <div class="card-list">
            <% @results.each do |chunk| %>
              <article class="card card-muted">
                <div class="card-title-row">
                  <div>
                    <h2><%= chunk.code_file.path %></h2>
                    <p class="page-copy">Lines <%= chunk.start_line %>–<%= chunk.end_line %></p>
                  </div>
                  <span class="status-pill"><%= chunk.chunk_type %></span>
                </div>
                <pre class="code-snippet"><%= truncate(chunk.chunk_text, length: 600) %></pre>
              </article>
            <% end %>
          </div>
        <% else %>
          <section class="empty-state">
            <h2>No matching chunks found</h2>
            <p>Try a more specific class, module, service, or workflow question.</p>
          </section>
        <% end %>
      </section>
    <% end %>
  </turbo-frame>
</div>
