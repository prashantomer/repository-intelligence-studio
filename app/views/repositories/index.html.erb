<% content_for :title, "Repositories" %>

<div class="page repositories-page">
  <%= render "shared/page_header",
             classes: "workspace-header-compact repository-page-header",
             eyebrow: "Admin",
             title: "Repositories",
             description: "Manage tracked repositories and review sync state.",
             actions: [
               link_to("AI Settings", edit_settings_path, class: "button button-secondary"),
               link_to("Add Repository", new_repository_path, class: "button button-primary")
             ] %>

  <% if @repositories.any? %>
    <section class="card repository-index-shell">
      <div class="repository-index-toolbar">
        <strong class="repository-index-toolbar-title">Repository inventory</strong>
        <div class="repository-index-toolbar-meta">
          <span class="status-pill">Public repositories</span>
          <span class="status-pill">Single workspace view</span>
        </div>
      </div>

      <div class="repository-list">
        <div class="repository-list-header">
          <span>Repository</span>
          <span>Source</span>
          <span>Assistant</span>
          <span>Embeddings</span>
          <span>Footprint</span>
          <span>Sync</span>
        </div>

      <% @repositories.each do |repository| %>
        <%= link_to repository_path(repository), class: "repository-row" do %>
          <article class="repository-row-main">
            <div class="repository-row-title repository-row-grid">
              <div>
                <h2><%= repository.name %></h2>
                <p class="card-url repository-row-url"><%= repository.github_url %></p>
              </div>
              <div class="repository-row-cell">
                <strong><%= repository.tracked_branch %></strong>
                <span class="repository-row-copy"><%= repository.provider %> · <%= repository.visibility.humanize %></span>
              </div>

              <div class="repository-row-cell">
                <strong><%= repository.assistant_provider %></strong>
                <span class="repository-row-copy"><%= repository.assistant_model %></span>
              </div>

              <div class="repository-row-cell">
                <strong><%= repository.embedding_provider %></strong>
                <span class="repository-row-copy"><%= repository.embedding_model %></span>
              </div>

              <div class="repository-row-cell">
                <strong><%= pluralize(repository.code_files.count, "file") %></strong>
                <span class="repository-row-copy"><%= repository.code_chunks.count %> chunks · <%= repository.entities.count %> entities</span>
              </div>

              <div class="repository-row-cell repository-row-sync">
                <span class="status-pill status-<%= repository.status %>"><%= repository.status.humanize %></span>
                <strong><%= repository.last_ingested_at ? repository.last_ingested_at.strftime("%Y-%m-%d %H:%M") : "Not yet" %></strong>
                <span class="repository-row-copy"><%= repository.entity_relationships.count %> relations</span>
              </div>
            </div>
          </article>
        <% end %>
      <% end %>
      </div>
    </section>
  <% else %>
    <section class="empty-state workspace-empty">
      <h2>No repositories yet</h2>
      <p>Create the first public repository record to start building the ingestion flow.</p>
      <%= link_to "Create Repository", new_repository_path, class: "button button-primary" %>
    </section>
  <% end %>
</div>
