<% content_for :title, "Repositories" %>

<div class="page repositories-page">
  <% if @repositories.any? %>
    <% total_repositories = @repositories.size %>
    <% completed_repositories = @repositories.count(&:completed?) %>
    <% failed_repositories = @repositories.count(&:failed?) %>
    <% pending_repositories = @repositories.count(&:pending?) %>
    <% skipped_repositories = @repositories.count(&:skipped?) %>

    <section class="metrics-grid repository-index-metrics-grid">
      <article class="card metric repository-index-metric-card">
        <span class="metric-label">Total</span>
        <span class="metric-value"><%= total_repositories %></span>
      </article>
      <article class="card metric repository-index-metric-card">
        <span class="metric-label">Completed</span>
        <span class="metric-value"><%= completed_repositories %></span>
      </article>
      <article class="card metric repository-index-metric-card">
        <span class="metric-label">Failed</span>
        <span class="metric-value"><%= failed_repositories %></span>
      </article>
      <article class="card metric repository-index-metric-card">
        <span class="metric-label">Pending</span>
        <span class="metric-value"><%= pending_repositories %></span>
      </article>
      <article class="card metric repository-index-metric-card">
        <span class="metric-label">Skipped</span>
        <span class="metric-value"><%= skipped_repositories %></span>
      </article>
    </section>

    <section class="card repository-index-shell">
      <div class="repository-index-toolbar">
        <div>
          <strong class="repository-index-toolbar-title">Repository inventory</strong>
          <p class="page-copy repository-index-toolbar-copy">Manage tracked repositories and monitor sync state.</p>
        </div>
        <div class="repository-index-toolbar-meta">
          <span class="status-pill">Public repositories</span>
          <span class="status-pill">Single workspace view</span>
        </div>
      </div>

      <div class="table-scroll repository-index-table-shell">
        <table class="data-table repository-index-table">
          <thead>
            <tr>
              <th>Repository</th>
              <th>Branch</th>
              <th>Source</th>
              <th>Files</th>
              <th>Chunks</th>
              <th>Entities</th>
              <th>Relations</th>
              <th>Sync Status</th>
              <th>Last Synced</th>
            </tr>
          </thead>
          <tbody>
            <% @repositories.each do |repository| %>
              <tr class="repository-index-table-row" data-href="<%= repository_path(repository) %>">
                <td>
                  <%= link_to repository_path(repository), class: "repository-index-primary-link" do %>
                    <strong><%= repository.name %></strong>
                  <% end %>
                  <div class="repository-row-copy"><%= repository.github_url %></div>
                </td>
                <td>
                  <strong><%= repository.tracked_branch %></strong>
                  <div class="repository-row-copy">Default: <%= repository.default_branch %></div>
                </td>
                <td>
                  <strong><%= repository.provider %></strong>
                  <div class="repository-row-copy"><%= repository.visibility.humanize %></div>
                </td>
                <td><%= repository.code_files.count %></td>
                <td><%= repository.code_chunks.count %></td>
                <td><%= repository.entities.count %></td>
                <td><%= repository.entity_relationships.count %></td>
                <td><span class="status-pill status-<%= repository.status %>"><%= repository.status.humanize %></span></td>
                <td>
                  <strong><%= repository.last_ingested_at ? repository.last_ingested_at.strftime("%Y-%m-%d %H:%M") : "Not yet" %></strong>
                  <div class="repository-row-copy"><%= repository.assistant_provider %> · <%= repository.embedding_provider %></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="empty-state workspace-empty">
      <h2>No repositories yet</h2>
      <p>Create the first public repository record to start building the ingestion flow.</p>
      <%= link_to "Create Repository", new_repository_path, class: "button button-primary" %>
    </section>
  <% end %>
</div>
