<div id="repository-show-content" class="page">
  <div class="modal-overlay is-hidden" id="repository-ingestion-history-modal" data-modal>
    <div class="modal-dialog impact-help-dialog repository-ingestion-history-dialog" role="dialog" aria-modal="true" aria-labelledby="repository-ingestion-history-title">
      <div class="section-title modal-header">
        <div>
          <h2 id="repository-ingestion-history-title">Ingestion History</h2>
          <p class="page-copy">Recent sync runs for this repository.</p>
        </div>
        <button type="button" class="button button-secondary button-compact" data-modal-close="repository-ingestion-history-modal">Close</button>
      </div>

      <div class="repository-ingestion-history-content">
        <div class="metrics-grid repository-ingestion-history-stats">
          <article class="metric">
            <span class="metric-label">Runs</span>
            <span class="metric-value"><%= recent_ingestions.size %></span>
          </article>
          <article class="metric">
            <span class="metric-label">Completed</span>
            <span class="metric-value"><%= recent_ingestions.count(&:completed?) %></span>
          </article>
          <article class="metric">
            <span class="metric-label">Failed</span>
            <span class="metric-value"><%= recent_ingestions.count(&:failed?) %></span>
          </article>
          <article class="metric">
            <span class="metric-label">Active</span>
            <span class="metric-value"><%= recent_ingestions.count(&:active?) %></span>
          </article>
          <article class="metric">
            <span class="metric-label">Forced Rebuilds</span>
            <span class="metric-value"><%= recent_ingestions.count(&:force_rebuild) %></span>
          </article>
        </div>

        <div class="table-scroll audit-log-table-shell impact-help-table-shell ingestion-history-table-shell">
        <% if recent_ingestions.any? %>
          <table class="data-table audit-log-table ingestion-history-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Status</th>
                <th>Branch</th>
                <th>Mode</th>
                <th>Commit SHA</th>
                <th>Started</th>
                <th>Finished</th>
                <th>Duration</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% recent_ingestions.each do |ingestion| %>
                <tr>
                  <td><%= ingestion.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                  <td><span class="status-pill status-<%= ingestion.status %>"><%= ingestion.status.humanize %></span></td>
                  <td><%= ingestion.branch_name %></td>
                  <td><%= ingestion.force_rebuild? ? "Forced" : "Normal" %></td>
                  <td><span class="table-code-cell"><%= ingestion.commit_sha.presence || "Not available" %></span></td>
                  <td><%= ingestion.started_at ? ingestion.started_at.strftime("%Y-%m-%d %H:%M") : "Not started" %></td>
                  <td><%= ingestion.finished_at ? ingestion.finished_at.strftime("%Y-%m-%d %H:%M") : "Not finished" %></td>
                  <td>
                    <% if ingestion.started_at && ingestion.finished_at %>
                      <%= distance_of_time_in_words(ingestion.started_at, ingestion.finished_at) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td><%= ingestion.error_message.presence || "None" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <section class="empty-state workspace-empty overview-empty-state">
            <h2>No ingestion history yet</h2>
            <p>Completed and failed sync runs will appear here once repository processing starts.</p>
          </section>
        <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay is-hidden" id="repository-audit-log-modal" data-modal>
    <div class="modal-dialog impact-help-dialog" role="dialog" aria-modal="true" aria-labelledby="repository-audit-log-title">
      <div class="section-title modal-header">
        <div>
          <h2 id="repository-audit-log-title">Audit Log</h2>
          <p class="page-copy">System-recorded repository events.</p>
        </div>
        <button type="button" class="button button-secondary button-compact" data-modal-close="repository-audit-log-modal">Close</button>
      </div>

      <div class="table-scroll audit-log-table-shell impact-help-table-shell">
        <% if recent_audit_logs.any? %>
          <table class="data-table audit-log-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Event</th>
              </tr>
            </thead>
            <tbody>
              <% recent_audit_logs.each do |log| %>
                <tr>
                  <td><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                  <td><%= log.message.presence || log.event %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <section class="empty-state workspace-empty overview-empty-state">
            <h2>No audit events yet</h2>
            <p>System activity will appear here as this repository is synced and queried.</p>
          </section>
        <% end %>
      </div>
    </div>
  </div>

  <div class="repository-overview-stack">
    <section class="card repository-overview-panel">
      <div class="section-title">
        <div>
          <h2>Repository Details</h2>
          <p class="page-copy">Core tracking, sync scope, and source metadata.</p>
        </div>
      </div>

      <dl class="meta-grid">
        <div>
          <dt>Status</dt>
          <dd><span class="status-pill status-<%= repository.status %>"><%= repository.status.humanize %></span></dd>
        </div>
        <div>
          <dt>Tracked branch</dt>
          <dd><%= repository.tracked_branch %></dd>
        </div>
        <div>
          <dt>Default branch</dt>
          <dd><%= repository.default_branch %></dd>
        </div>
        <div>
          <dt>Visibility</dt>
          <dd><%= repository.visibility.humanize %></dd>
        </div>
        <div>
          <dt>Provider</dt>
          <dd><%= repository.provider %></dd>
        </div>
        <div>
          <dt>Last commit SHA</dt>
          <dd><%= repository.last_commit_sha.presence || "Not available" %></dd>
        </div>
        <div>
          <dt>Last ingested at</dt>
          <dd><%= repository.last_ingested_at ? repository.last_ingested_at.strftime("%Y-%m-%d %H:%M") : "Not yet" %></dd>
        </div>
      </dl>
    </section>

    <section class="card repository-overview-panel">
      <div class="section-title">
        <div>
          <h2>Repository Stats</h2>
          <p class="page-copy">Indexed footprint and dependency graph totals for this repository snapshot.</p>
        </div>
      </div>

      <div class="metrics-grid">
        <article class="metric">
          <span class="metric-label">Files</span>
          <span class="metric-value"><%= code_files_count %></span>
        </article>
        <article class="metric">
          <span class="metric-label">Chunks</span>
          <span class="metric-value"><%= code_chunks_count %></span>
        </article>
        <article class="metric">
          <span class="metric-label">Entities</span>
          <span class="metric-value"><%= entities_count %></span>
        </article>
        <article class="metric">
          <span class="metric-label">Relations</span>
          <span class="metric-value"><%= relationships_count %></span>
        </article>
        <article class="metric">
          <span class="metric-label">Routes</span>
          <span class="metric-value"><%= routes_count %></span>
        </article>
        <article class="metric">
          <span class="metric-label">Dependency Edges</span>
          <span class="metric-value"><%= dependency_edges_count %></span>
        </article>
      </div>
    </section>

    <section class="card repository-overview-panel">
      <div class="section-title">
        <div>
          <h2>Latest Ingestion</h2>
          <p class="page-copy">Most recent sync execution status and commit snapshot.</p>
        </div>
      </div>

      <% if latest_ingestion.present? %>
        <dl class="meta-grid">
          <div>
            <dt>Status</dt>
            <dd><span class="status-pill status-<%= latest_ingestion.status %>"><%= latest_ingestion.status.humanize %></span></dd>
          </div>
          <div>
            <dt>Branch</dt>
            <dd><%= latest_ingestion.branch_name %></dd>
          </div>
          <div>
            <dt>Commit SHA</dt>
            <dd><%= latest_ingestion.commit_sha.presence || "Not available" %></dd>
          </div>
          <div>
            <dt>Started</dt>
            <dd><%= latest_ingestion.started_at ? latest_ingestion.started_at.strftime("%Y-%m-%d %H:%M") : "Not started" %></dd>
          </div>
          <div>
            <dt>Finished</dt>
            <dd><%= latest_ingestion.finished_at ? latest_ingestion.finished_at.strftime("%Y-%m-%d %H:%M") : "Not finished" %></dd>
          </div>
          <div>
            <dt>Error</dt>
            <dd><%= latest_ingestion.error_message.presence || "None" %></dd>
          </div>
        </dl>
      <% else %>
        <section class="empty-state workspace-empty overview-empty-state">
          <h2>No ingestion run yet</h2>
          <p>Queue the first re-sync to build repository chunks, embeddings, and grounded assistant context.</p>
        </section>
      <% end %>
    </section>

  </div>
</div>
