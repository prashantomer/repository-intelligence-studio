<% content_for :title, "Assistant #{@repository.name}" %>

<div class="page">
  <%= turbo_stream_from [@repository, :assistant] %>

  <%= render "shared/page_header",
             classes: "workspace-header-compact",
             eyebrow: "Repository Assistant",
             title: @repository.name,
             description: "Repository-scoped grounded Q&A.",
             meta_items: [
               "Provider: #{@repository.assistant_provider}",
               "Model: #{@repository.assistant_model}",
               "Thread: #{@conversation&.title || "New conversation"}"
             ],
             actions: [
               link_to("Back to Repository", repository_path(@repository), class: "button button-secondary"),
               link_to("AI Settings", edit_settings_path, class: "button button-secondary"),
               link_to("Search Chunks", search_repository_path(@repository), class: "button button-secondary")
             ] %>

  <div class="assistant-layout">
    <aside class="assistant-sidebar">
      <section class="card card-muted assistant-panel">
        <div class="section-title">
          <div>
            <h2>Session</h2>
            <p class="page-copy">Current thread state.</p>
          </div>
        </div>

        <div class="table-scroll assistant-mini-table-shell" id="assistant-session-stats">
          <table class="data-table assistant-mini-table">
            <tbody>
              <tr>
                <th>Messages</th>
                <td><%= @messages.count %></td>
              </tr>
              <tr>
                <th>Repository</th>
                <td><%= @repository.name %></td>
              </tr>
              <tr>
                <th>Scope</th>
                <td><%= @repository.tracked_branch %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card card-muted assistant-panel">
        <div class="section-title">
          <div>
            <h2>Good Questions</h2>
            <p class="page-copy">Example prompts.</p>
          </div>
        </div>

        <ol class="assistant-compact-list assistant-prompt-list">
          <li class="assistant-compact-item">How does request execution flow through this repository?</li>
          <li class="assistant-compact-item">Which files define the ingestion and re-sync logic?</li>
          <li class="assistant-compact-item">What would break if I change the embedding provider?</li>
          <li class="assistant-compact-item">Summarize the architecture for a new engineer.</li>
        </ol>
      </section>

      <section class="card card-muted assistant-panel">
        <div class="section-title">
          <div>
            <h2>Answer Pipeline</h2>
            <p class="page-copy">Execution path.</p>
          </div>
        </div>

        <div class="table-scroll assistant-mini-table-shell">
          <table class="data-table assistant-mini-table">
            <tbody>
              <tr>
                <th>Retrieve</th>
                <td>Semantic search stays inside this repository snapshot.</td>
              </tr>
              <tr>
                <th>Ground</th>
                <td>Relevant chunks and citations are assembled into prompt context.</td>
              </tr>
              <tr>
                <th>Respond</th>
                <td><%= @repository.assistant_provider %> / <%= @repository.assistant_model %> generates the final answer.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </aside>

    <section class="card assistant-chat-shell">
      <div class="assistant-chat-header">
        <div>
          <h2>Conversation</h2>
          <p class="page-copy">Grounded repository thread.</p>
        </div>
        <div class="assistant-chat-meta" id="assistant-thread-status">
          <span class="status-pill"><%= @messages.any? ? "Active thread" : "No messages yet" %></span>
        </div>
      </div>

      <%= render "repositories/assistant/chat_body", repository: @repository, messages: @messages %>
      <%= render "repositories/assistant/composer", repository: @repository, conversation: @conversation %>
    </section>
  </div>
</div>
