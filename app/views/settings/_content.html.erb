<div id="settings-content" class="page">
  <section class="hero-card">
    <div class="page-header">
      <div>
        <p class="eyebrow">User Settings</p>
        <h1>Centralized AI Settings</h1>
        <p class="page-copy">These settings apply across all repositories owned by the current user. Update them once here instead of per repository.</p>
      </div>

      <div class="hero-actions">
        <%= link_to "Back to Repositories", repositories_path, class: "button button-secondary" %>
      </div>
    </div>
  </section>

  <div class="two-column-grid">
    <section class="card">
      <div class="section-title">
        <div>
          <h2>AI Configuration</h2>
          <p class="page-copy">Assistant generation and embedding retrieval defaults for every repository.</p>
        </div>
      </div>

      <%= form_with model: user, url: settings_path, method: :patch,
                    html: {
                      data: {
                        controller: "model-picker",
                        assistant_catalog: assistant_model_catalog_json,
                        embedding_catalog: embedding_model_catalog_json,
                        initial_assistant_ready: user.assistant_provider_ready?,
                        initial_embedding_ready: user.embedding_provider_ready?,
                        initial_assistant_requirement: user.assistant_provider_requirement,
                        initial_embedding_requirement: user.embedding_provider_requirement,
                        initial_embedding_supported: embedding_profile[:embeddings_supported]
                      }
                    } do |form| %>
        <% if user.errors.any? %>
          <section class="error-box">
            <h2><%= pluralize(user.errors.count, "error") %> prevented saving these settings</h2>
            <ul>
              <% user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <div class="settings-stack">
          <div class="settings-section-grid">
            <section class="card card-muted compact-card">
              <div class="section-title">
                <div>
                  <h2>Profile</h2>
                  <p class="page-copy">Owner-level defaults for all repositories under this user.</p>
                </div>
              </div>

              <div class="form-grid">
                <div class="field">
                  <%= form.label :name, "Profile name" %>
                  <%= form.text_field :name, placeholder: "Default User" %>
                </div>
              </div>
            </section>

            <section class="card card-muted compact-card"
                     data-model-picker-target="connectionCard">
              <div class="section-title">
                <div>
                  <h2>Provider Connection</h2>
                  <p class="page-copy">Used when a self-hosted runtime is selected.</p>
                </div>
              </div>

              <div class="form-grid">
                <div class="field">
                  <%= form.label :ollama_base_url, "Ollama base URL" %>
                  <%= form.url_field :ollama_base_url, placeholder: "http://127.0.0.1:11434" %>
                  <span class="field-hint">Used when either assistant or embedding provider is set to `Ollama`.</span>
                </div>
              </div>
            </section>
          </div>

          <div class="settings-section-grid">
            <section class="card card-muted compact-card">
              <div class="section-title">
                <div>
                  <h2>Assistant Generation</h2>
                  <p class="page-copy">Controls answer generation after grounded retrieval.</p>
                </div>
              </div>

              <div class="form-grid two-up">
                <div class="field">
                  <%= form.label :assistant_provider, "Assistant provider" %>
                  <%= form.select :assistant_provider,
                                  User::ASSISTANT_PROVIDERS.values.map { |value| [value.humanize, value] },
                                  {},
                                  data: { model_picker_target: "assistantProvider", action: "change->model-picker#assistantProviderChanged" } %>
                </div>

                <div class="field">
                  <%= form.label :assistant_model, "Assistant preset" %>
                  <%= select_tag :assistant_model_preset,
                                 options_for_select(AiModelCatalog.assistant_models_for(user.assistant_provider), user.assistant_model),
                                 include_blank: "Custom model",
                                 data: { model_picker_target: "assistantPreset", action: "change->model-picker#assistantPresetChanged" } %>
                </div>
              </div>

              <div class="form-grid">
                <div class="field">
                  <%= form.label :assistant_model, "Assistant model override" %>
                  <%= form.text_field :assistant_model,
                                      placeholder: "Pick a suggested model or type your own",
                                      data: { model_picker_target: "assistantInput" } %>
                  <span class="field-hint">Manual model names are still allowed.</span>
                </div>
              </div>

              <div class="timeline-list compact-timeline">
                <article class="timeline-item">
                  <span class="timeline-title">Capability</span>
                  <span class="timeline-meta">Assistant generation is supported for <%= user.assistant_provider.humanize %>.</span>
                </article>
                <article class="timeline-item">
                  <span class="timeline-title">Credential status</span>
                  <span class="timeline-meta" data-model-picker-target="assistantStatus">
                    <%= user.assistant_provider_ready? ? "Ready" : "Not ready" %> · <%= user.assistant_provider_requirement %>
                  </span>
                </article>
              </div>
            </section>

            <section class="card card-muted compact-card">
              <div class="section-title">
                <div>
                  <h2>Embedding & Retrieval</h2>
                  <p class="page-copy">Controls semantic search and chunk similarity.</p>
                </div>
              </div>

              <div class="form-grid two-up">
                <div class="field">
                  <%= form.label :embedding_provider, "Embedding provider" %>
                  <%= form.select :embedding_provider,
                                  User::EMBEDDING_PROVIDERS.values.map { |value| [value.humanize, value] },
                                  {},
                                  data: { model_picker_target: "embeddingProvider", action: "change->model-picker#embeddingProviderChanged" } %>
                </div>

                <div class="field">
                  <%= form.label :embedding_model, "Embedding preset" %>
                  <%= select_tag :embedding_model_preset,
                                 options_for_select(AiModelCatalog.embedding_models_for(user.embedding_provider), user.embedding_model),
                                 include_blank: "Custom model",
                                 data: { model_picker_target: "embeddingPreset", action: "change->model-picker#embeddingPresetChanged" } %>
                </div>
              </div>

              <div class="form-grid">
                <div class="field">
                  <%= form.label :embedding_model, "Embedding model override" %>
                  <%= form.text_field :embedding_model,
                                      placeholder: "Pick a suggested model or type your own",
                                      data: { model_picker_target: "embeddingInput" } %>
                  <span class="field-hint">Current storage is fixed at 1024 dimensions. Use Local or Ollama embeddings and re-sync after any embedding change.</span>
                </div>
              </div>

              <div class="timeline-list compact-timeline">
                <article class="timeline-item">
                  <span class="timeline-title">Capability</span>
                  <span class="timeline-meta" data-model-picker-target="embeddingCapability">
                    <%= embedding_profile[:embeddings_supported] ? "Embedding retrieval is supported for #{user.embedding_provider.humanize} on the current 1024-dimension storage baseline." : "#{user.embedding_provider.humanize} embeddings are disabled on the current storage baseline." %>
                  </span>
                </article>
                <article class="timeline-item">
                  <span class="timeline-title">Credential status</span>
                  <span class="timeline-meta" data-model-picker-target="embeddingStatus">
                    <%= user.embedding_provider_ready? ? "Ready" : "Not ready" %> · <%= user.embedding_provider_requirement %>
                  </span>
                </article>
              </div>
            </section>
          </div>
        </div>

        <div class="button-row">
          <%= form.submit "Save AI Settings", class: "button button-primary" %>
        </div>
      <% end %>
    </section>

    <aside class="card card-muted">
      <div class="section-title">
        <div>
          <h2>Provider Status</h2>
          <p class="page-copy">Current runtime readiness and support boundaries.</p>
        </div>
      </div>

      <div class="timeline-list">
        <article class="timeline-item">
          <span class="timeline-title">Assistant runtime</span>
          <span class="timeline-meta">
            <%= user.assistant_provider.humanize %> ·
            <%= user.assistant_provider_ready? ? "ready to use" : "missing runtime requirement" %>
          </span>
        </article>
        <article class="timeline-item">
          <span class="timeline-title">Embedding runtime</span>
          <span class="timeline-meta" data-model-picker-target="sidebarEmbeddingStatus">
            <%= user.embedding_provider.humanize %> · <%= user.embedding_provider_ready? ? "ready to use" : "missing runtime requirement or unsupported" %>
          </span>
        </article>
        <article class="timeline-item">
          <span class="timeline-title">Embedding baseline</span>
          <span class="timeline-meta" data-model-picker-target="anthropicNotice">Current storage is fixed at 1024 dimensions. Use `local` or `Ollama` embeddings now; provider-portable vector routing is planned later.</span>
        </article>
        <article class="timeline-item">
          <span class="timeline-title">Re-index requirement</span>
          <span class="timeline-meta">If embedding provider or model changes, re-sync repositories to rebuild stored vectors.</span>
        </article>
      </div>
    </aside>
  </div>
</div>
